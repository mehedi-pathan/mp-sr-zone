[previousMonthHigh, previousMonthLow] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

f_contrast_text(color backgroundColor) =>
    luminance = color.r(backgroundColor) * 0.299 + color.g(backgroundColor) * 0.587 + color.b(backgroundColor) * 0.114
    luminance > 150 ? color.black : color.white

f_sync_previous_level(array<line> levelLines, array<label> levelLabels, int levelIndex, bool enabled, float levelPrice, color levelColor, string levelName) =>
    storedLine = array.get(levelLines, levelIndex)
    storedLabel = array.get(levelLabels, levelIndex)
    if enabled and not na(levelPrice)
        if na(storedLine)
            storedLine := line.new(bar_index - 1, levelPrice, bar_index + 1, levelPrice, xloc=xloc.bar_index, extend=extend.right, color=levelColor, width=2)
            array.set(levelLines, levelIndex, storedLine)
        else
            line.set_xy1(storedLine, bar_index - 1, levelPrice)
            line.set_xy2(storedLine, bar_index + 1, levelPrice)
            line.set_color(storedLine, levelColor)
        if na(storedLabel)
            storedLabel := label.new(bar_index + 1, levelPrice, levelName, xloc=xloc.bar_index, yloc=yloc.price, color=levelColor, textcolor=f_contrast_text(levelColor), style=label.style_label_left, size=size.tiny, tooltip=str.tostring(levelPrice, format.mintick))
            array.set(levelLabels, levelIndex, storedLabel)
        else
            label.set_xy(storedLabel, bar_index + 1, levelPrice)
            label.set_color(storedLabel, levelColor)
            label.set_textcolor(storedLabel, f_contrast_text(levelColor))
            label.set_tooltip(storedLabel, str.tostring(levelPrice, format.mintick))
    else
        line.delete(storedLine)
        label.delete(storedLabel)
        array.set(levelLines, levelIndex, na)
        array.set(levelLabels, levelIndex, na)

var array<line> previousLevelLines = array.new<line>(8, na)
var array<label> previousLevelLabels = array.new<label>(8, na)
if barstate.islast
    chartSeconds = timeframe.in_seconds()
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 0, showPrev4hHigh and chartSeconds <= timeframe.in_seconds("240"), previous4hHigh, prev4hColor, "Prev 4H High")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 1, showPrev4hLow and chartSeconds <= timeframe.in_seconds("240"), previous4hLow, prev4hColor, "Prev 4H Low")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 2, showPrevDayHigh and chartSeconds <= timeframe.in_seconds("D"), previousDayHigh, prevDayColor, "Prev Day High")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 3, showPrevDayLow and chartSeconds <= timeframe.in_seconds("D"), previousDayLow, prevDayColor, "Prev Day Low")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 4, showPrevWeekHigh and chartSeconds <= timeframe.in_seconds("W"), previousWeekHigh, prevWeekColor, "Prev Week High")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 5, showPrevWeekLow and chartSeconds <= timeframe.in_seconds("W"), previousWeekLow, prevWeekColor, "Prev Week Low")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 6, showPrevMonthHigh and chartSeconds <= timeframe.in_seconds("M"), previousMonthHigh, prevMonthColor, "Prev Month High")
    f_sync_previous_level(previousLevelLines, previousLevelLabels, 7, showPrevMonthLow and chartSeconds <= timeframe.in_seconds("M"), previousMonthLow, prevMonthColor, "Prev Month Low")