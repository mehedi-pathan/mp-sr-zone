engulf_delete_fib_lines(fib_lines, fib_labels) =>
    if not engulfKeepPrevLevels
        if array.size(fib_lines) > 0
            for i = 0 to array.size(fib_lines) - 1
                line.delete(array.get(fib_lines, i))
        array.clear(fib_lines)
        if array.size(fib_labels) > 0
            for i = 0 to array.size(fib_labels) - 1
                label.delete(array.get(fib_labels, i))
        array.clear(fib_labels)

engulf_create_fibonacci_lines(is_bullish, fib_high, fib_low, start_time, end_time, tf_string, fib_lines, fib_labels) =>
    engulf_delete_fib_lines(fib_lines, fib_labels)
    price_range = fib_high - fib_low
    fib_0 = is_bullish ? fib_low : fib_high
    fib_25 = is_bullish ? fib_low + (price_range * 0.25) : fib_high - (price_range * 0.25)
    fib_50 = is_bullish ? fib_low + (price_range * 0.50) : fib_high - (price_range * 0.50)
    fib_75 = is_bullish ? fib_low + (price_range * 0.75) : fib_high - (price_range * 0.75)
