//==============================================================================
// CORE PRICE / TREND DATA
//==============================================================================
atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, volAtrAvgLen)

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
pivotVolume = volume[pivotLen]
pivotVolumeMaximum = ta.highest(volume, volBoxFilterLen)[pivotLen]
pivotHasHighVolume = not na(pivotVolume) and not na(pivotVolumeMaximum) and pivotVolume >= pivotVolumeMaximum
mpStructurePivotHigh = ta.pivothigh(high, mpBOSLength, mpBOSLength)
mpStructurePivotLow = ta.pivotlow(low, mpBOSLength, mpBOSLength)

var float mpStructureHigh = na
var int mpStructureHighBar = na
var bool mpStructureHighBroken = false
var float mpStructureLow = na
var int mpStructureLowBar = na
var bool mpStructureLowBroken = false
var int mpStructureDirection = 0

if not na(mpStructurePivotHigh)
    mpStructureHigh := mpStructurePivotHigh
    mpStructureHighBar := bar_index - mpBOSLength
    mpStructureHighBroken := false

if not na(mpStructurePivotLow)
    mpStructureLow := mpStructurePivotLow
    mpStructureLowBar := bar_index - mpBOSLength
    mpStructureLowBroken := false

// Trendlines connect the two latest confirmed swing highs and lows. Pivot
// confirmation is delayed by pivotLen bars, so the lines do not use future data.
var float trendlinePriorHigh = na
var float trendlineLatestHigh = na
var int trendlinePriorHighBar = na
var int trendlineLatestHighBar = na
var float trendlinePriorLow = na
var float trendlineLatestLow = na
var int trendlinePriorLowBar = na
var int trendlineLatestLowBar = na
var line trendlineHigh = na
var line trendlineLow = na
var label trendlineHighMarker = na
var label trendlineLowMarker = na

if not na(ph)
    trendlinePriorHigh := trendlineLatestHigh
    trendlinePriorHighBar := trendlineLatestHighBar
    trendlineLatestHigh := ph
    trendlineLatestHighBar := bar_index - pivotLen
    if showTrendlines and not na(trendlinePriorHigh)
        line.delete(trendlineHigh)
        trendlineHigh := line.new(trendlinePriorHighBar, trendlinePriorHigh, trendlineLatestHighBar, trendlineLatestHigh, xloc=xloc.bar_index, extend=extend.right, color=mpBOSBearColor, width=2)

if not na(pl)
    trendlinePriorLow := trendlineLatestLow
    trendlinePriorLowBar := trendlineLatestLowBar
    trendlineLatestLow := pl
    trendlineLatestLowBar := bar_index - pivotLen
    if showTrendlines and not na(trendlinePriorLow)
        line.delete(trendlineLow)
        trendlineLow := line.new(trendlinePriorLowBar, trendlinePriorLow, trendlineLatestLowBar, trendlineLatestLow, xloc=xloc.bar_index, extend=extend.right, color=mpBOSBullColor, width=2)

if showTrendlineSwingMarkers and not na(ph)
    if na(trendlineHighMarker)
        trendlineHighMarker := label.new(bar_index - pivotLen, ph, "SH", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=mpBOSBearColor, textcolor=color.white, size=size.tiny)
    else
        label.set_xy(trendlineHighMarker, bar_index - pivotLen, ph)

if showTrendlineSwingMarkers and not na(pl)
    if na(trendlineLowMarker)
        trendlineLowMarker := label.new(bar_index - pivotLen, pl, "SL", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=mpBOSBullColor, textcolor=color.white, size=size.tiny)
    else
        label.set_xy(trendlineLowMarker, bar_index - pivotLen, pl)

if not showTrendlineSwingMarkers
    label.delete(trendlineHighMarker)
    label.delete(trendlineLowMarker)
    trendlineHighMarker := na
    trendlineLowMarker := na

if not showTrendlines
    line.delete(trendlineHigh)
    line.delete(trendlineLow)
    trendlineHigh := na
    trendlineLow := na

mpBullStructureBreak = barstate.isconfirmed and not na(mpStructureHigh) and not mpStructureHighBroken and bar_index >= mpStructureHighBar + mpBOSLength and close > mpStructureHigh and close[1] <= mpStructureHigh
