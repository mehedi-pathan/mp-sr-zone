downSignal = (downScore > upScore and edge >= minEdge and nextCandleQualityScore >= minQuality and not conflictDetected and not isExhaustion) or (downScore >= upScore and bearishPressure and edge >= minEdge and nextCandleQualityScore >= minQuality - 5 and not conflictDetected and not isExhaustion)
strongUp = upSignal and edge >= strongEdge and nextCandleQualityScore >= strongQuality and not conflictDetected and not isExhaustion
strongDown = downSignal and edge >= strongEdge and nextCandleQualityScore >= strongQuality and not conflictDetected and not isExhaustion

finalSignal = "NO TRADE"
if strongUp
    finalSignal := "STRONG UP"
else if upSignal
    finalSignal := "UP"
else if strongDown
    finalSignal := "STRONG DOWN"
else if downSignal
    finalSignal := "DOWN"

finalSignalNoTrade = finalSignal == "NO TRADE"
finalSignalDirection = finalSignal == "UP" or finalSignal == "STRONG UP" ? "UP" : finalSignal == "DOWN" or finalSignal == "STRONG DOWN" ? "DOWN" : "NO TRADE"

var string nextCandleSignal = "NO TRADE"
var string nextCandleReason = "No trade: insufficient evidence"
var float nextCandleUpScore = 0.0
var float nextCandleDownScore = 0.0
var float nextCandleEdge = 0.0
var float nextCandleQuality = 0.0
var bool signalChanged = false

if barstate.isconfirmed
    nextCandleUpScore := upScore
    nextCandleDownScore := downScore
    nextCandleEdge := edge
    nextCandleQuality := nextCandleQualityScore
    nextCandleSignal := finalSignalDirection
    if finalSignalDirection == "NO TRADE"
        nextCandleReason := "Insufficient edge, poor market quality, conflict, or exhaustion risk"
        if conflictDetected
            nextCandleReason := "Conflict detected: mixed HTF/trend/momentum structure"
        if isExhaustion
            nextCandleReason := "Exhaustion risk: premium expansion and fading follow-through"
    else
        nextCandleReason := (finalSignalDirection == "UP" ? "HTF bullish; EMA alignment; RSI rising; structure supportive; location favorable" : "HTF bearish; EMA alignment; RSI falling; structure supportive; location favorable")
        if strongUp or strongDown
            nextCandleReason := nextCandleReason + "; strong directional edge"
    signalChanged := nextCandleSignal != nextCandleSignal[1]

signalLabel = nextCandleSignal == "UP" or nextCandleSignal == "STRONG UP" ? "↑" : nextCandleSignal == "DOWN" or nextCandleSignal == "STRONG DOWN" ? "↓" : "•"

nextSignalText = nextCandleSignal == "UP" ? "BUY" : nextCandleSignal == "DOWN" ? "SELL" : "WAIT"

