//@version=6
indicator("MP SR Zone • Next Candle Engine", shorttitle="MP SR ZONE", overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

//==============================================================================
// MP SR ZONE — NEXT CANDLE PREDICTION ENGINE
// Preserves the existing zone-based analysis and adds a non-repainting, next-candle
// directional model designed for 1m and 2m charts.
//==============================================================================

//----------------------------------------------------------------------------- 
// GENERAL
//-----------------------------------------------------------------------------
showAll = input.bool(true, "Show all", group="01 • General")
scalpMode = input.string("1-2 Minute", "Scalp mode", options=["1-2 Minute", "1 Minute", "2 Minute"], group="01 • General")
showSignalMarkers = input.bool(false, "Show signal markers", group="01 • General")
showLegacySetupMarkers = input.bool(false, "Show legacy setup markers", group="01 • General")
showBreakoutMarkers = input.bool(false, "Show breakout markers", group="01 • General")
showNoTradeMarker = input.bool(false, "Show no-trade marker", group="01 • General")
showBarColor = input.bool(false, "Color bars", group="01 • General")
showZoneLabels = input.bool(true, "Show zone labels", group="01 • General")
warnOnLowQuality = input.bool(true, "Warn on low-quality signals", group="01 • General")
showVolume = input.bool(true, "Show volume", group="01 • General")
volumeMode = input.string("Delta Volume", "Volume mode", options=["Delta Volume"], group="01 • General")

//----------------------------------------------------------------------------- 
// ZONE ENGINE
//-----------------------------------------------------------------------------
showMPZones = input.bool(true, "Show MP zones", group="02 • Scalping Zone Engine")
showSupport = input.bool(true, "Show support", group="02 • Scalping Zone Engine")
showResistance = input.bool(true, "Show resistance", group="02 • Scalping Zone Engine")
showHighVolumeZones = input.bool(true, "Show high-volume boxes", group="02 • Scalping Zone Engine")
showATRZones = input.bool(false, "Show ATR zones", group="02 • Scalping Zone Engine")
showCandleZones = input.bool(false, "Show candle zones", group="02 • Scalping Zone Engine")
showTouchZones = input.bool(false, "Show touch zones", group="02 • Scalping Zone Engine")
showSDZones = input.bool(false, "Show supply/demand zones", group="02 • Scalping Zone Engine")
showComposite = input.bool(false, "Show composite zone", group="02 • Scalping Zone Engine")
showFreshZones = input.bool(true, "Show fresh zones", group="02 • Scalping Zone Engine")
showClassic = input.bool(false, "Show classic S/R", group="02 • Scalping Zone Engine")
showTrendlines = input.bool(false, "Show trendlines", group="02 • Scalping Zone Engine")
showZigzag = input.bool(false, "Show zigzag", group="02 • Scalping Zone Engine")
pivotLen = input.int(3, "Pivot length", minval=2, maxval=20, group="02 • Scalping Zone Engine")
atrLen = input.int(14, "ATR length", minval=5, maxval=50, group="02 • Scalping Zone Engine")
atrZoneMult = input.float(0.25, "ATR zone multiplier", step=0.01, group="02 • Scalping Zone Engine")
signalZoneMult = input.float(0.30, "Signal zone multiplier", step=0.01, group="02 • Scalping Zone Engine")
zoneExtend = input.int(40, "Zone extend bars", minval=10, maxval=200, group="02 • Scalping Zone Engine")
maxZonesSide = input.int(2, "Max zone count", minval=1, maxval=10, group="02 • Scalping Zone Engine")
volBoxFilterLen = input.int(2, "High-volume filter", minval=1, maxval=20, group="02 • Scalping Zone Engine")
volBoxWidth = input.float(1.0, "High-volume box width", minval=0.1, maxval=10.0, step=0.1, group="02 • Scalping Zone Engine")

//----------------------------------------------------------------------------- 
// SMART SNR
//-----------------------------------------------------------------------------
smartSnrEnabled = input.bool(true, "Show Smart SnR", group="02 • Scalping Zone Engine")
smartSnrType = input.string("Swing HiLo", "SnR Type", options=["Volume", "Swing HiLo"], group="02 • Scalping Zone Engine")
smartSnrPeriod = input.int(20, "Swing Period", minval=1, maxval=50, group="02 • Scalping Zone Engine")
smartSnrLineStyleI = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="02 • Scalping Zone Engine")
smartSnrLineStyle = smartSnrLineStyleI == "Solid" ? line.style_solid : smartSnrLineStyleI == "Dashed" ? line.style_dashed : line.style_dotted
smartSnrLineWidth = input.int(1, "Linewidth", minval=1, maxval=5, group="02 • Scalping Zone Engine")
smartSnrExtendI = input.string("None", "Line Extend", options=["None", "Left", "Right", "Both"], group="02 • Scalping Zone Engine")
smartSnrExtend = smartSnrExtendI == "None" ? extend.none : smartSnrExtendI == "Left" ? extend.left : smartSnrExtendI == "Both" ? extend.both : extend.right
smartSupLabel = input.color(color.new(color.black, 90), "Support Label", group="02 • Scalping Zone Engine", inline="1")
smartSupText = input.color(color.red, "Text", group="02 • Scalping Zone Engine", inline="1")
smartSupLine = input.color(color.red, "Line", group="02 • Scalping Zone Engine", inline="1")
smartResLabel = input.color(color.new(color.black, 90), "Resistance Label", group="02 • Scalping Zone Engine", inline="2")
smartResText = input.color(color.blue, "Text", group="02 • Scalping Zone Engine", inline="2")
smartResLine = input.color(color.blue, "Line", group="02 • Scalping Zone Engine", inline="2")

//----------------------------------------------------------------------------- 
// TOUCH / SD / SUPPORT
//-----------------------------------------------------------------------------
minTouches = input.int(2, "Min touches", minval=1, maxval=10, group="03 • Zone Strength")
touchLookback = input.int(100, "Touch lookback", minval=20, maxval=250, group="03 • Zone Strength")
touchToleranceATR = input.float(0.15, "Touch tolerance ATR", step=0.01, group="03 • Zone Strength")
showStrengthText = input.bool(true, "Show strength text", group="03 • Zone Strength")

sdImpulseATR = input.float(0.80, "SD impulse ATR", step=0.05, group="04 • Supply / Demand")
showTestedZones = input.bool(true, "Show tested zones", group="04 • Supply / Demand")
showBrokenZones = input.bool(false, "Show broken zones", group="04 • Supply / Demand")

//----------------------------------------------------------------------------- 
// TREND / MTF / MOMENTUM
//-----------------------------------------------------------------------------
useTrendFilter = input.bool(true, "Use trend filter", group="05 • Trend / Bias")
emaFastLen = input.int(9, "EMA fast", minval=3, maxval=50, group="05 • Trend / Bias")
emaSlowLen = input.int(21, "EMA slow", minval=8, maxval=80, group="05 • Trend / Bias")
showEMAs = input.bool(true, "Plot EMAs", group="05 • Trend / Bias")

useMTFFilter = input.bool(true, "Use HTF filter", group="06 • Higher Timeframe Filter")
mtfTf = input.string("5", "MTF timeframe", options=["5", "15", "30"], group="06 • Higher Timeframe Filter")
mtfFastLen = input.int(20, "HTF fast EMA", minval=5, maxval=50, group="06 • Higher Timeframe Filter")
mtfSlowLen = input.int(50, "HTF slow EMA", minval=10, maxval=200, group="06 • Higher Timeframe Filter")
confirmedMTF = input.bool(true, "Use confirmed HTF values", group="06 • Higher Timeframe Filter")

useRSI = input.bool(true, "Use RSI", group="07 • Momentum")
rsiLen = input.int(14, "RSI length", minval=5, maxval=50, group="07 • Momentum")
rsiBullLevel = input.float(50.0, "RSI bull level", step=1.0, group="07 • Momentum")
rsiBearLevel = input.float(50.0, "RSI bear level", step=1.0, group="07 • Momentum")

useBreakout = input.bool(true, "Use breakout logic", group="07 • Momentum")

useStoch = input.bool(true, "Use stochastic", group="07 • Momentum")
stochLen = input.int(14, "Stoch length", minval=5, maxval=50, group="07 • Momentum")
stochSmooth = input.int(3, "Stoch smooth", minval=1, maxval=10, group="07 • Momentum")
stochBullLevel = input.float(55.0, "Stoch bull threshold", step=1.0, group="07 • Momentum")
stochBearLevel = input.float(45.0, "Stoch bear threshold", step=1.0, group="07 • Momentum")

//----------------------------------------------------------------------------- 
// STRUCTURE / PRICE ACTION / VOLATILITY
//-----------------------------------------------------------------------------
structureLen = input.int(5, "Swing structure length", minval=3, maxval=30, group="08 • Structure")
structureTrendMin = input.float(0.7, "Structure trend min", step=0.1, group="08 • Structure")

useRejection = input.bool(true, "Use candle rejection", group="09 • Price Action")
useEngulfing = input.bool(true, "Use engulfing confirmation", group="09 • Price Action")
minWickBodyRatio = input.float(1.20, "Min wick/body ratio", step=0.05, group="09 • Price Action")
bodyQualityMin = input.float(0.55, "Body quality min", step=0.05, group="09 • Price Action")
closeBiasMin = input.float(0.60, "Close bias min", step=0.05, group="09 • Price Action")

volLowThreshold = input.float(0.0025, "Low vol threshold", step=0.0005, group="10 • Volatility")
volNormalThreshold = input.float(0.0070, "Normal vol threshold", step=0.0005, group="10 • Volatility")
volExtremeThreshold = input.float(0.0150, "Extreme vol threshold", step=0.0005, group="10 • Volatility")
volAtrAvgLen = input.int(20, "Vol ATR average length", minval=5, maxval=50, group="10 • Volatility")

//----------------------------------------------------------------------------- 
// S/R LOCATION / SESSION / EXHAUSTION / SIGNAL FILTER
//-----------------------------------------------------------------------------
entryBufferATR = input.float(0.15, "Entry buffer ATR", step=0.01, group="11 • Support / Resistance")
useSessionFilter = input.bool(false, "Use session context", group="12 • Session")

exhaustionBodyMult = input.float(1.8, "Exhaustion body multiplier", step=0.1, group="13 • Exhaustion")
exhaustionDistanceMult = input.float(2.4, "Exhaustion distance multiplier", step=0.1, group="13 • Exhaustion")
maxConflict = input.float(0.55, "Conflict threshold", step=0.05, group="14 • Signal Filter")
minEdge = input.float(12.0, "Min edge", step=1.0, group="14 • Signal Filter")
strongEdge = input.float(28.0, "Strong edge threshold", step=1.0, group="14 • Signal Filter")
minQuality = input.float(55.0, "Min market quality", step=1.0, group="14 • Signal Filter")
strongQuality = input.float(75.0, "Strong market quality", step=1.0, group="14 • Signal Filter")

//----------------------------------------------------------------------------- 
// DASHBOARD / ALERTS / STATISTICS
//-----------------------------------------------------------------------------
showDashboard = input.bool(true, "Show dashboard", group="15 • Dashboard")
showReasonCodes = input.bool(false, "Show reason codes", group="15 • Dashboard")
showAlerts = input.bool(true, "Enable alerts", group="16 • Alerts")
showStats = input.bool(false, "Show statistics", group="17 • Backtest / Statistics")

//----------------------------------------------------------------------------- 
// ENGULFING TIMEFRAME LEVELS (5m / 15m / 30m / 45m)
//-----------------------------------------------------------------------------
engulfLevelGroup = "18 • MTF Engulfing Levels"
engulfShowLevels = input.bool(true, "Show TF levels", group=engulfLevelGroup)
engulfFilterEngulfing = input.bool(false, "Filter engulfing", group=engulfLevelGroup)
engulfTf5Enabled = input.bool(true, "5m", group=engulfLevelGroup)
engulfTf15Enabled = input.bool(true, "15m", group=engulfLevelGroup)
engulfTf30Enabled = input.bool(true, "30m", group=engulfLevelGroup)
engulfTf45Enabled = input.bool(true, "45m", group=engulfLevelGroup)
engulfKeepPrevLevels = input.bool(false, "Keep previous level lines", group=engulfLevelGroup)
engulfShowLabel = input.bool(false, "Show timeframe label", group=engulfLevelGroup)
engulfExtendLines = input.bool(false, "Extend level lines", group=engulfLevelGroup)
engulfFib0Color = input.color(color.new(color.green, 0), "0%", group=engulfLevelGroup, inline="1")
engulfFib25Color = input.color(color.new(color.lime, 0), "25%", group=engulfLevelGroup, inline="1")
engulfFib50Color = input.color(color.new(color.gray, 0), "50%", group=engulfLevelGroup, inline="2")
engulfFib75Color = input.color(color.new(color.red, 0), "75%", group=engulfLevelGroup, inline="2")
engulfFib100Color = input.color(color.new(color.red, 0), "100%", group=engulfLevelGroup, inline="3")
engulfFib0Style = input.string("Solid", "Style 0", options=["Solid", "Dashed", "Dotted"], group=engulfLevelGroup, inline="4")
engulfFib25Style = input.string("Dotted", "Style 25", options=["Solid", "Dashed", "Dotted"], group=engulfLevelGroup, inline="4")
engulfFib50Style = input.string("Dashed", "Style 50", options=["Solid", "Dashed", "Dotted"], group=engulfLevelGroup, inline="5")
engulfFib75Style = input.string("Dotted", "Style 75", options=["Solid", "Dashed", "Dotted"], group=engulfLevelGroup, inline="5")
engulfFib100Style = input.string("Solid", "Style 100", options=["Solid", "Dashed", "Dotted"], group=engulfLevelGroup, inline="6")
engulfTableEnabled = input.bool(true, "Show watching TF table", group=engulfLevelGroup)
engulfTablePosition = input.string("middle_right", "Table position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group=engulfLevelGroup)
engulfTableTextSize = input.string("small", "Table text size", options=["large", "normal", "small", "tiny"], group=engulfLevelGroup)
engulfPatternMarkers = input.bool(true, "Show engulfing markers", group=engulfLevelGroup)
engulfBarColor = input.bool(true, "Color bars on engulfing", group=engulfLevelGroup)
engulfPatternAlerts = input.bool(true, "Enable engulfing alerts", group=engulfLevelGroup)

//----------------------------------------------------------------------------- 
// COLORS
//-----------------------------------------------------------------------------
supportColor = color.new(color.rgb(76, 175, 80), 88)
resistanceColor = color.new(color.rgb(244, 67, 54), 88)
atrColor = color.new(color.rgb(33, 150, 243), 90)
candleColor = color.new(color.rgb(255, 152, 0), 90)
touchColor = color.new(color.rgb(96, 125, 139), 92)
sdDemandColor = color.new(color.rgb(76, 175, 80), 86)
sdSupplyColor = color.new(color.rgb(244, 67, 54), 86)
compositeColor = color.new(color.rgb(255, 235, 59), 88)
freshColor = color.new(color.white, 96)

//==============================================================================
// CORE PRICE / TREND DATA
//==============================================================================
atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, volAtrAvgLen)

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

rsi = ta.rsi(close, rsiLen)
stochRaw = ta.stoch(close, high, low, stochLen)
stochK = ta.sma(stochRaw, stochSmooth)
stochD = ta.sma(stochK, stochSmooth)

trendStrengthRaw = math.abs(close - close[1])
adxVal = ta.rma(trendStrengthRaw, atrLen)

body = math.abs(close - open)
barRange = math.max(high - low, syminfo.mintick)
bodyRatio = barRange > 0 ? body / barRange : 0.0
closePosition = barRange > 0 ? (close - low) / barRange : 0.5
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

bullPin = close > open and lowerWick >= body * minWickBodyRatio
bearPin = close < open and upperWick >= body * minWickBodyRatio
bullEngulf = close > open and close >= open[1] and open <= close[1] and close[1] < open[1]
bearEngulf = close < open and open >= close[1] and close <= open[1] and close[1] > open[1]
bullRejection = bullPin or (useEngulfing and bullEngulf)
bearRejection = bearPin or (useEngulfing and bearEngulf)

//==============================================================================
// MTF CONTEXT
//==============================================================================
mtfFastS = request.security(syminfo.tickerid, mtfTf, ta.ema(close, mtfFastLen), lookahead=barmerge.lookahead_off)
mtfSlowS = request.security(syminfo.tickerid, mtfTf, ta.ema(close, mtfSlowLen), lookahead=barmerge.lookahead_off)
mtfRsiS = request.security(syminfo.tickerid, mtfTf, ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_off)

mtfFast = confirmedMTF ? mtfFastS[1] : mtfFastS
mtfSlow = confirmedMTF ? mtfSlowS[1] : mtfSlowS
mtfBull = mtfFast > mtfSlow and mtfRsiS > 50
mtfBear = mtfFast < mtfSlow and mtfRsiS < 50

//==============================================================================
// SESSION CONTEXT (real market session windows)
//==============================================================================
// Use market session windows directly so Pine reads the real open state for
// Sydney, Tokyo, London, and New York without false OFF HOURS readings.
nyOpen = not na(time(timeframe.period, "0930-1600", "America/New_York"))
ldnOpen = not na(time(timeframe.period, "0800-1700", "Europe/London"))
tokyoOpen = not na(time(timeframe.period, "0900-1500", "Asia/Tokyo"))
sydneyOpen = not na(time(timeframe.period, "1000-1700", "Australia/Sydney"))

marketClockText = "OFF HOURS"
if nyOpen and ldnOpen
    marketClockText := "LONDON + NY"
else if nyOpen
    marketClockText := "NEW YORK"
else if ldnOpen
    marketClockText := "LONDON"
else if tokyoOpen
    marketClockText := "TOKYO"
else if sydneyOpen
    marketClockText := "SYDNEY"

sessionLabel = marketClockText

// Keep both directions possible in the scoring engine. Do not force only bullish bias
// during NY hours; otherwise the chart will suppress sell-side signals.
sessionBullBias = nyOpen or ldnOpen
sessionBearBias = tokyoOpen or sydneyOpen

//==============================================================================
// EXISTING ZONE LOGIC (kept for compatibility)
//==============================================================================
var box[] supportBoxes = array.new_box()
var box[] resistanceBoxes = array.new_box()
var box[] strongSupportBoxes = array.new_box()
var box[] strongResistanceBoxes = array.new_box()
var box coreSupportBox = na
var box coreResistanceBox = na
var string[] supportNames = array.new_string()
var string[] resistanceNames = array.new_string()
var float coreSupport = na
var float coreResistance = na
var float coreSupportTop = na
var float coreResistanceBottom = na

f_delete_oldest(_boxes, _names, _max) =>
    while array.size(_boxes) > _max
        oldBox = array.shift(_boxes)
        array.remove(_names, 0)
        box.delete(oldBox)

f_count_support_touches(_level, _tol) =>
    int count = 0
    for i = 0 to touchLookback - 1
        if not na(low[i]) and math.abs(low[i] - _level) <= _tol
            count += 1
    count

f_count_resistance_touches(_level, _tol) =>
    int count = 0
    for i = 0 to touchLookback - 1
        if not na(high[i]) and math.abs(high[i] - _level) <= _tol
            count += 1
    count

f_add_support(_bottom, _top, _name, _bg) =>
    if showAll and showMPZones and showSupport
        b = box.new(left=bar_index - pivotLen, top=_top, right=bar_index + zoneExtend, bottom=_bottom,
             bgcolor=_bg, border_color=color.new(color.lime, 40), border_width=1,
             text=showZoneLabels ? _name : "", text_color=color.white, text_size=size.tiny)
        array.push(supportBoxes, b)
        array.push(supportNames, _name)
        f_delete_oldest(supportBoxes, supportNames, maxZonesSide)

f_add_resistance(_bottom, _top, _name, _bg) =>
    if showAll and showMPZones and showResistance
        b = box.new(left=bar_index - pivotLen, top=_top, right=bar_index + zoneExtend, bottom=_bottom,
             bgcolor=_bg, border_color=color.new(color.red, 40), border_width=1,
             text=showZoneLabels ? _name : "", text_color=color.white, text_size=size.tiny)
        array.push(resistanceBoxes, b)
        array.push(resistanceNames, _name)
        f_delete_oldest(resistanceBoxes, resistanceNames, maxZonesSide)

newSupport = not na(pl)
newResistance = not na(ph)
pivotSupport = newSupport ? pl : na
pivotResistance = newResistance ? ph : na

var int lastSupportBar = na
var float lastSupportLevel = na
var int lastResistanceBar = na
var float lastResistanceLevel = na

if newSupport
    coreSupport := pivotSupport
    coreSupportTop := pivotSupport + atr[pivotLen] * signalZoneMult
    lastSupportBar := bar_index - pivotLen
    lastSupportLevel := pivotSupport
    if na(coreSupportBox)
        coreSupportBox := box.new(left=bar_index - pivotLen, top=coreSupportTop, right=bar_index, bottom=coreSupport,
             bgcolor=supportColor, border_color=color.new(color.lime, 40), border_width=1,
             text=showZoneLabels ? "SUPPORT" : "", text_color=color.white, text_size=size.tiny)
    if showHighVolumeZones and showSupport and volume >= ta.highest(volume, volBoxFilterLen)
        boxW = math.max(atr, syminfo.mintick) * volBoxWidth
        b = box.new(left=bar_index - pivotLen, top=pivotSupport + boxW, right=bar_index + zoneExtend, bottom=pivotSupport - boxW,
             bgcolor=color.new(color.lime, 88), border_color=color.new(color.lime, 40), border_width=1,
             text="SUPPORT • VOL: " + str.tostring(volume), text_color=color.white, text_size=size.tiny)
        array.push(strongSupportBoxes, b)
        while array.size(strongSupportBoxes) > maxZonesSide
            oldBox = array.shift(strongSupportBoxes)
            box.delete(oldBox)

if not na(coreSupport)
    if na(coreSupportBox)
        coreSupportBox := box.new(left=bar_index - pivotLen, top=coreSupportTop, right=bar_index, bottom=coreSupport,
             bgcolor=supportColor, border_color=color.new(color.lime, 40), border_width=1,
             text=showZoneLabels ? "SUPPORT" : "", text_color=color.white, text_size=size.tiny)
    box.set_left(coreSupportBox, bar_index - pivotLen)
    box.set_right(coreSupportBox, bar_index)
    box.set_top(coreSupportBox, coreSupportTop)
    box.set_bottom(coreSupportBox, coreSupport)
    box.set_bgcolor(coreSupportBox, supportColor)
    box.set_text(coreSupportBox, showZoneLabels ? "SUPPORT" : "")

if newResistance
    coreResistance := pivotResistance
    coreResistanceBottom := pivotResistance - atr[pivotLen] * signalZoneMult
    lastResistanceBar := bar_index - pivotLen
    lastResistanceLevel := pivotResistance
    if na(coreResistanceBox)
        coreResistanceBox := box.new(left=bar_index - pivotLen, top=coreResistance, right=bar_index, bottom=coreResistanceBottom,
             bgcolor=resistanceColor, border_color=color.new(color.red, 40), border_width=1,
             text=showZoneLabels ? "RESISTANCE" : "", text_color=color.white, text_size=size.tiny)
    if showHighVolumeZones and showResistance and volume >= ta.highest(volume, volBoxFilterLen)
        boxW = math.max(atr, syminfo.mintick) * volBoxWidth
        b = box.new(left=bar_index - pivotLen, top=pivotResistance + boxW, right=bar_index + zoneExtend, bottom=pivotResistance - boxW,
             bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 40), border_width=1,
             text="RESISTANCE • VOL: " + str.tostring(volume), text_color=color.white, text_size=size.tiny)
        array.push(strongResistanceBoxes, b)
        while array.size(strongResistanceBoxes) > maxZonesSide
            oldBox = array.shift(strongResistanceBoxes)
            box.delete(oldBox)

if not na(coreResistance)
    if na(coreResistanceBox)
        coreResistanceBox := box.new(left=bar_index - pivotLen, top=coreResistance, right=bar_index, bottom=coreResistanceBottom,
             bgcolor=resistanceColor, border_color=color.new(color.red, 40), border_width=1,
             text=showZoneLabels ? "RESISTANCE" : "", text_color=color.white, text_size=size.tiny)
    box.set_left(coreResistanceBox, bar_index - pivotLen)
    box.set_right(coreResistanceBox, bar_index)
    box.set_top(coreResistanceBox, coreResistance)
    box.set_bottom(coreResistanceBox, coreResistanceBottom)
    box.set_bgcolor(coreResistanceBox, resistanceColor)
    box.set_text(coreResistanceBox, showZoneLabels ? "RESISTANCE" : "")

if newSupport and showATRZones
    p = pivotSupport
    w = atr[pivotLen] * atrZoneMult
    f_add_support(p - w, p + w, "A ATR SUPPORT", atrColor)

if newResistance and showATRZones
    p = pivotResistance
    w = atr[pivotLen] * atrZoneMult
    f_add_resistance(p - w, p + w, "A ATR RESISTANCE", atrColor)

if newSupport and showCandleZones
    idx = pivotLen
    candleTop = math.max(open[idx], close[idx])
    candleBottom = low[idx]
    f_add_support(candleBottom, candleTop, "B CANDLE DEMAND", candleColor)

if newResistance and showCandleZones
    idx = pivotLen
    candleTop = high[idx]
    candleBottom = math.min(open[idx], close[idx])
    f_add_resistance(candleBottom, candleTop, "B CANDLE SUPPLY", candleColor)

if newSupport and showTouchZones
    tol = atr[pivotLen] * touchToleranceATR
    touches = f_count_support_touches(pivotSupport, tol)
    if touches >= minTouches
        f_add_support(pivotSupport - tol, pivotSupport + tol, "C SUPPORT • " + str.tostring(touches) + "T", touchColor)

if newResistance and showTouchZones
    tol = atr[pivotLen] * touchToleranceATR
    touches = f_count_resistance_touches(pivotResistance, tol)
    if touches >= minTouches
        f_add_resistance(pivotResistance - tol, pivotResistance + tol, "C RESISTANCE • " + str.tostring(touches) + "T", touchColor)

if newSupport and showSDZones
    idx = pivotLen
    impulse = high - low
