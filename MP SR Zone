stochBearOK = not useStoch or (stochK < stochD and stochK <= stochBearLevel)
rejectionBullOK = not useRejection or bullRejection
rejectionBearOK = not useRejection or bearRejection

var int lastTouchSupportBar = na
var int lastTouchResistanceBar = na
