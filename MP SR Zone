alertcondition(engulfPatternAlerts and engulf_current_bull and not engulf_current_bull_prev, title="Bullish Engulfing", message="MP SR Zone: Bullish Engulfing detected")
alertcondition(engulfPatternAlerts and engulf_current_bear and not engulf_current_bear_prev, title="Bearish Engulfing", message="MP SR Zone: Bearish Engulfing detected")

