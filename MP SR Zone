exhaustionBearRisk += body > atr * exhaustionBodyMult and close < open ? 6.0 : 0.0
exhaustionBullRisk += math.abs(close - emaFast) > atr * exhaustionDistanceMult and close > emaFast ? 6.0 : 0.0
exhaustionBearRisk += math.abs(close - emaFast) > atr * exhaustionDistanceMult and close < emaFast ? 6.0 : 0.0
exhaustionBullRisk += rsi > 70 and close > open ? 4.0 : 0.0
exhaustionBearRisk += rsi < 30 and close < open ? 4.0 : 0.0
exhaustionBullRisk += upperWick > body * 1.5 and close > open ? 3.0 : 0.0
exhaustionBearRisk += lowerWick > body * 1.5 and close < open ? 3.0 : 0.0
exhaustionBullRisk += not na(coreResistance) and close > coreResistance - atr * 0.35 and close < coreResistance + atr * 0.35 ? 4.0 : 0.0
exhaustionBearRisk += not na(coreSupport) and close > coreSupport - atr * 0.35 and close < coreSupport + atr * 0.35 ? 4.0 : 0.0

conflictScore = 0.0
if mtfBull and trendUp > trendDown and (rsi < 50 or close < open or not na(coreResistance) and close > coreResistance - atr * 0.4)
