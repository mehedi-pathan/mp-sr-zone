    locationDown += close < coreResistance and close > coreSupport and distResistance < 1.5 and distSupport > 1.0 ? 8.0 : 0.0
    locationUp += close > coreSupport and close < coreResistance and close > (coreSupport + coreResistance) / 2 ? 2.0 : 0.0
    locationDown += close < coreResistance and close > coreSupport and close < (coreSupport + coreResistance) / 2 ? 2.0 : 0.0
