engulf_delete_fib_lines(fib_lines, fib_labels) =>
    if not engulfKeepPrevLevels
        if array.size(fib_lines) > 0
            for i = 0 to array.size(fib_lines) - 1
                line.delete(array.get(fib_lines, i))
        array.clear(fib_lines)
        if array.size(fib_labels) > 0
            for i = 0 to array.size(fib_labels) - 1
                label.delete(array.get(fib_labels, i))
        array.clear(fib_labels)

engulf_create_fibonacci_lines(is_bullish, fib_high, fib_low, start_time, end_time, tf_string, fib_lines, fib_labels) =>
    engulf_delete_fib_lines(fib_lines, fib_labels)
    price_range = fib_high - fib_low
    fib_0 = is_bullish ? fib_low : fib_high
    fib_25 = is_bullish ? fib_low + (price_range * 0.25) : fib_high - (price_range * 0.25)
    fib_50 = is_bullish ? fib_low + (price_range * 0.50) : fib_high - (price_range * 0.50)
    fib_75 = is_bullish ? fib_low + (price_range * 0.75) : fib_high - (price_range * 0.75)
    fib_100 = is_bullish ? fib_high : fib_low
    line_extend = engulfExtendLines ? extend.right : extend.none

    line_0 = line.new(start_time, fib_0, end_time, fib_0, color=engulfFib0Color, style=engulf_get_line_style(engulfFib0Style), extend=line_extend, xloc=xloc.bar_time)
    array.push(fib_lines, line_0)
    line_25 = line.new(start_time, fib_25, end_time, fib_25, color=engulfFib25Color, style=engulf_get_line_style(engulfFib25Style), extend=line_extend, xloc=xloc.bar_time)
    array.push(fib_lines, line_25)
    line_50 = line.new(start_time, fib_50, end_time, fib_50, color=engulfFib50Color, style=engulf_get_line_style(engulfFib50Style), extend=line_extend, xloc=xloc.bar_time)
    array.push(fib_lines, line_50)
    line_75 = line.new(start_time, fib_75, end_time, fib_75, color=engulfFib75Color, style=engulf_get_line_style(engulfFib75Style), extend=line_extend, xloc=xloc.bar_time)
    array.push(fib_lines, line_75)
    line_100 = line.new(start_time, fib_100, end_time, fib_100, color=engulfFib100Color, style=engulf_get_line_style(engulfFib100Style), extend=line_extend, xloc=xloc.bar_time)
    array.push(fib_lines, line_100)

    if engulfShowLabel
        label_text = tf_string + " Fib"
        tf_label = label.new(start_time, fib_0, text=label_text, style=label.style_label_left, color=color.new(color.black, 80), textcolor=color.white, size=size.small, xloc=xloc.bar_time)
        array.push(fib_labels, tf_label)

