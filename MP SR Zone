snrHAA = snrPlCond and snrP1 == snrPl1 and snrP2 == snrPl2
snrL = snrPlCond
snrLA = snrPhCond and snrP1 == snrPh1
snrLAA = snrPhCond and snrP1 == snrPh1 and snrP2 == snrPl2

snrH0 = ta.valuewhen(snrH, high[smartSnrPeriod], 0)
