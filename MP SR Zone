             bgcolor=_bg, border_color=color.new(color.red, 40), border_width=1,
             text=showZoneLabels ? _name : "", text_color=color.white, text_size=size.tiny)
        array.push(resistanceBoxes, b)
        array.push(resistanceNames, _name)
        f_delete_oldest(resistanceBoxes, resistanceNames, maxZonesSide)

