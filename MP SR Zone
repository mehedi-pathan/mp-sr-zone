//==============================================================================
// ORDER BLOCK FINDER
//==============================================================================
// An order block is the opposite-color candle immediately before the configured
// run of directional candles. Detection waits for the current bar to close.
obPeriod = obPeriods + 1
obAbsMove = not na(close[obPeriod]) and close[obPeriod] != 0.0 ? math.abs(close[obPeriod] - close[1]) / math.abs(close[obPeriod]) * 100.0 : na
obMoveRelevant = not na(obAbsMove) and obAbsMove >= obThreshold

int obUpCandles = 0
int obDownCandles = 0
for obIndex = 1 to obPeriods
    obUpCandles += close[obIndex] > open[obIndex] ? 1 : 0
    obDownCandles += close[obIndex] < open[obIndex] ? 1 : 0

obBullCandle = not na(close[obPeriod]) and close[obPeriod] < open[obPeriod]
obBearCandle = not na(close[obPeriod]) and close[obPeriod] > open[obPeriod]
obBullDetected = barstate.isconfirmed and obBullCandle and obUpCandles == obPeriods and obMoveRelevant
obBearDetected = barstate.isconfirmed and obBearCandle and obDownCandles == obPeriods and obMoveRelevant

obBullHigh = obBullDetected ? (obUseWicks ? high[obPeriod] : open[obPeriod]) : na
obBullLow = obBullDetected ? low[obPeriod] : na
obBullAverage = (obBullHigh + obBullLow) / 2.0
obBearHigh = obBearDetected ? high[obPeriod] : na
obBearLow = obBearDetected ? (obUseWicks ? low[obPeriod] : open[obPeriod]) : na
obBearAverage = (obBearHigh + obBearLow) / 2.0

obBullColor = obColorScheme == "DARK" ? color.white : color.green
obBearColor = obColorScheme == "DARK" ? color.blue : color.red

plotshape(obShowMarkers and obBullDetected, title="Bullish Order Block", style=shape.triangleup, color=obBullColor, textcolor=obBullColor, size=size.tiny, location=location.belowbar, offset=-obPeriod, text="Bullish OB")
