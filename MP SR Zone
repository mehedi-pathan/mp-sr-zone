//==============================================================================
// FAIR VALUE GAPS AND IMBALANCES
//==============================================================================
// Gaps are created only after the detection candle closes. Bullish zones always
// use top > bottom so box geometry remains valid on TradingView.
f_gap_right_boundary(extensionMode, extensionBars) =>
    extensionMode == "None" ? bar_index : extensionMode == "Limited" ? bar_index + extensionBars : last_bar_index + 3

f_add_gap(array<box> zoneBoxes, array<line> midLines, array<label> zoneLabels, float zoneTop, float zoneBottom, color zoneColor, string zoneName, int startBar, string extensionMode, int extensionBars, int keepCount) =>
    rightBar = f_gap_right_boundary(extensionMode, extensionBars)
    midpoint = (zoneTop + zoneBottom) / 2.0
    zoneBox = box.new(left=startBar, top=zoneTop, right=rightBar, bottom=zoneBottom, bgcolor=color.new(zoneColor, fvgTransparency), border_color=zoneColor)
    midpointLine = line.new(startBar, midpoint, rightBar, midpoint, xloc=xloc.bar_index, color=color.new(zoneColor, 45), style=line.style_dashed)
    zoneLabel = label.new(rightBar, midpoint, zoneName, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.rgb(18, 23, 30), 5), textcolor=color.white, style=label.style_label_left, textalign=text.align_right, size=size.tiny, tooltip="From: " + str.tostring(zoneBottom, format.mintick) + " To: " + str.tostring(zoneTop, format.mintick))
    array.unshift(zoneBoxes, zoneBox)
    array.unshift(midLines, midpointLine)
    array.unshift(zoneLabels, zoneLabel)
    while array.size(zoneBoxes) > keepCount
        box.delete(array.pop(zoneBoxes))
        line.delete(array.pop(midLines))
        label.delete(array.pop(zoneLabels))

f_clear_gap(array<box> zoneBoxes, array<line> midLines, array<label> zoneLabels) =>
    while array.size(zoneBoxes) > 0
        box.delete(array.pop(zoneBoxes))
        line.delete(array.pop(midLines))
        label.delete(array.pop(zoneLabels))

f_update_default_gap_extension(array<box> zoneBoxes, array<line> midLines, array<label> zoneLabels, string extensionMode) =>
    if barstate.islast and extensionMode == "Default" and array.size(zoneBoxes) > 0
        rightBar = last_bar_index + 3
        for gapIndex = 0 to array.size(zoneBoxes) - 1
            box.set_right(array.get(zoneBoxes, gapIndex), rightBar)
            line.set_x2(array.get(midLines, gapIndex), rightBar)
            label.set_x(array.get(zoneLabels, gapIndex), rightBar)

var array<box> bullFvgBoxes = array.new<box>()
var array<line> bullFvgMidLines = array.new<line>()
var array<label> bullFvgLabels = array.new<label>()
var array<box> bearFvgBoxes = array.new<box>()
var array<line> bearFvgMidLines = array.new<line>()
var array<label> bearFvgLabels = array.new<label>()
var array<box> bullImbalanceBoxes = array.new<box>()
var array<line> bullImbalanceMidLines = array.new<line>()
var array<label> bullImbalanceLabels = array.new<label>()
var array<box> bearImbalanceBoxes = array.new<box>()
var array<line> bearImbalanceMidLines = array.new<line>()
var array<label> bearImbalanceLabels = array.new<label>()

if barstate.isconfirmed and bar_index >= 2 and showBullFvg and high[2] < low
    f_add_gap(bullFvgBoxes, bullFvgMidLines, bullFvgLabels, low, high[2], bullFvgColor, "Bullish FVG", bar_index - 2, bullFvgExtend, bullFvgExtendBars, bullFvgCount)
if barstate.isconfirmed and bar_index >= 2 and showBearFvg and low[2] > high
    f_add_gap(bearFvgBoxes, bearFvgMidLines, bearFvgLabels, low[2], high, bearFvgColor, "Bearish FVG", bar_index - 2, bearFvgExtend, bearFvgExtendBars, bearFvgCount)

// An imbalance is a candle-to-candle open/close gap, distinct from the 3-bar FVG.
if barstate.isconfirmed and bar_index >= 1 and showBullImbalance and close[1] < open
    f_add_gap(bullImbalanceBoxes, bullImbalanceMidLines, bullImbalanceLabels, open, close[1], bullImbalanceColor, "Bullish Imbalance", bar_index - 1, bullImbalanceExtend, bullImbalanceExtendBars, bullImbalanceCount)
if barstate.isconfirmed and bar_index >= 1 and showBearImbalance and close[1] > open
    f_add_gap(bearImbalanceBoxes, bearImbalanceMidLines, bearImbalanceLabels, close[1], open, bearImbalanceColor, "Bearish Imbalance", bar_index - 1, bearImbalanceExtend, bearImbalanceExtendBars, bearImbalanceCount)

if not showBullFvg
    f_clear_gap(bullFvgBoxes, bullFvgMidLines, bullFvgLabels)
if not showBearFvg
    f_clear_gap(bearFvgBoxes, bearFvgMidLines, bearFvgLabels)
if not showBullImbalance
    f_clear_gap(bullImbalanceBoxes, bullImbalanceMidLines, bullImbalanceLabels)
if not showBearImbalance
    f_clear_gap(bearImbalanceBoxes, bearImbalanceMidLines, bearImbalanceLabels)

f_update_default_gap_extension(bullFvgBoxes, bullFvgMidLines, bullFvgLabels, bullFvgExtend)
f_update_default_gap_extension(bearFvgBoxes, bearFvgMidLines, bearFvgLabels, bearFvgExtend)
f_update_default_gap_extension(bullImbalanceBoxes, bullImbalanceMidLines, bullImbalanceLabels, bullImbalanceExtend)
f_update_default_gap_extension(bearImbalanceBoxes, bearImbalanceMidLines, bearImbalanceLabels, bearImbalanceExtend)

//==============================================================================
// SWING LEVELS AND DIRECTIONAL TARGET
//==============================================================================
// A swing is the middle candle of a confirmed three-candle local extreme.
f_swing_right_boundary(extensionMode, extensionBars) =>
    extensionMode == "None" ? bar_index : extensionMode == "Limited" ? bar_index + extensionBars : last_bar_index + 3

f_add_swing_level(array<line> swingLines, array<label> swingLabels, float swingPrice, int swingBar, color swingColor, string swingName, string extensionMode, int extensionBars, int keepCount) =>
    rightBar = f_swing_right_boundary(extensionMode, extensionBars)
    swingLine = line.new(swingBar, swingPrice, rightBar, swingPrice, xloc=xloc.bar_index, color=swingColor, width=1)
    swingLabel = label.new(rightBar, swingPrice, swingName, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.rgb(18, 23, 30), 5), textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=str.tostring(swingPrice, format.mintick))
    array.unshift(swingLines, swingLine)
    array.unshift(swingLabels, swingLabel)
    while array.size(swingLines) > keepCount
        line.delete(array.pop(swingLines))
        label.delete(array.pop(swingLabels))

f_clear_swing_levels(array<line> swingLines, array<label> swingLabels) =>
    while array.size(swingLines) > 0
        line.delete(array.pop(swingLines))
        label.delete(array.pop(swingLabels))

f_update_default_swing_extension(array<line> swingLines, array<label> swingLabels, string extensionMode) =>
    if barstate.islast and extensionMode == "Default" and array.size(swingLines) > 0
        rightBar = last_bar_index + 3
        for swingIndex = 0 to array.size(swingLines) - 1
            line.set_x2(array.get(swingLines, swingIndex), rightBar)
            label.set_x(array.get(swingLabels, swingIndex), rightBar)

var array<line> swingHighLines = array.new<line>()
var array<label> swingHighLevelLabels = array.new<label>()
var array<line> swingLowLines = array.new<line>()
var array<label> swingLowLevelLabels = array.new<label>()
var array<float> targetSwingHighPrices = array.new<float>()
var array<int> targetSwingHighBars = array.new<int>()
var array<float> targetSwingLowPrices = array.new<float>()
var array<int> targetSwingLowBars = array.new<int>()

isSwingHigh = barstate.isconfirmed and bar_index >= 2 and high[1] > high and high[1] > high[2]
isSwingLow = barstate.isconfirmed and bar_index >= 2 and low[1] < low and low[1] < low[2]

if isSwingHigh
    array.unshift(targetSwingHighPrices, high[1])
    array.unshift(targetSwingHighBars, bar_index - 1)
    if array.size(targetSwingHighPrices) > 100
        array.pop(targetSwingHighPrices)
        array.pop(targetSwingHighBars)
    if showSwingHighLevels
        f_add_swing_level(swingHighLines, swingHighLevelLabels, high[1], bar_index - 1, swingHighColor, "Swing High", swingHighExtend, swingHighExtendBars, swingHighCount)

if isSwingLow
    array.unshift(targetSwingLowPrices, low[1])
    array.unshift(targetSwingLowBars, bar_index - 1)
    if array.size(targetSwingLowPrices) > 100
        array.pop(targetSwingLowPrices)
        array.pop(targetSwingLowBars)
    if showSwingLowLevels
        f_add_swing_level(swingLowLines, swingLowLevelLabels, low[1], bar_index - 1, swingLowColor, "Swing Low", swingLowExtend, swingLowExtendBars, swingLowCount)

if not showSwingHighLevels
    f_clear_swing_levels(swingHighLines, swingHighLevelLabels)
if not showSwingLowLevels
    f_clear_swing_levels(swingLowLines, swingLowLevelLabels)

f_update_default_swing_extension(swingHighLines, swingHighLevelLabels, swingHighExtend)
f_update_default_swing_extension(swingLowLines, swingLowLevelLabels, swingLowExtend)

var line currentTargetLine = na
var label currentTargetLabel = na
if barstate.islast
    line.delete(currentTargetLine)
    label.delete(currentTargetLabel)
    currentTargetLine := na
    currentTargetLabel := na
    if showNextTarget and close > open and array.size(targetSwingHighPrices) > 0
        for targetIndex = 0 to array.size(targetSwingHighPrices) - 1
            targetPrice = array.get(targetSwingHighPrices, targetIndex)
            if targetPrice > close
                targetBar = array.get(targetSwingHighBars, targetIndex)
                currentTargetLine := line.new(targetBar, targetPrice, bar_index + 6, targetPrice, xloc=xloc.bar_index, color=nextTargetHighColor, width=2, style=line.style_dashed)
                currentTargetLabel := label.new(bar_index + 6, targetPrice, "Potential Target", xloc=xloc.bar_index, yloc=yloc.price, color=nextTargetHighColor, textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=str.tostring(targetPrice, format.mintick))
                break
    else if showNextTarget and close < open and array.size(targetSwingLowPrices) > 0
        for targetIndex = 0 to array.size(targetSwingLowPrices) - 1
            targetPrice = array.get(targetSwingLowPrices, targetIndex)
            if targetPrice < close
                targetBar = array.get(targetSwingLowBars, targetIndex)
                currentTargetLine := line.new(targetBar, targetPrice, bar_index + 6, targetPrice, xloc=xloc.bar_index, color=nextTargetLowColor, width=2, style=line.style_dashed)
                currentTargetLabel := label.new(bar_index + 6, targetPrice, "Potential Target", xloc=xloc.bar_index, yloc=yloc.price, color=nextTargetLowColor, textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=str.tostring(targetPrice, format.mintick))
                break

