fill(obBullHighPlot, obBullLowPlot, color=color.new(obBullColor, obFillTransparency), title="Bullish OB zone")
plotshape(obBullAverage, title="Bullish OB Average", style=shape.cross, color=obBullColor, size=size.tiny, location=location.absolute, offset=-obPeriod)

plotshape(obShowMarkers and obBearDetected, title="Bearish Order Block", style=shape.triangledown, color=obBearColor, textcolor=obBearColor, size=size.tiny, location=location.abovebar, offset=-obPeriod, text="Bearish OB")
