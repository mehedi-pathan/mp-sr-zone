snrPh1 = ta.valuewhen(snrPhCond, close[smartSnrPeriod], 1)
snrPh2 = ta.valuewhen(snrPhCond, close[smartSnrPeriod], 2)

snrPl0 = ta.valuewhen(snrPlCond, close[smartSnrPeriod], 0)
